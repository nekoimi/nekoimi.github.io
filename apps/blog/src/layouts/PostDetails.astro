---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Tag from '../components/Tag.astro';
import Datetime from '../components/Datetime.astro';
import ShareLinks from '../components/ShareLinks.astro';
import BackToTopButton from '../components/BackToTopButton.astro';
import { slugifyStr } from '../utils/slugify';
import getPostSlug from '../utils/getPostSlug';
import { SITE } from '../config';

type Props = {
  post: CollectionEntry<'blog'>;
  posts: CollectionEntry<'blog'>[];
};

const { post, posts } = Astro.props;
const { Content } = await post.render();

const currentIndex = posts.findIndex(item => item.id === post.id);
const previousPost = currentIndex > 0 ? posts[currentIndex - 1] : null;
const nextPost =
  currentIndex >= 0 && currentIndex < posts.length - 1 ? posts[currentIndex + 1] : null;
const canonicalUrl = new URL(`/posts/${getPostSlug(post.id)}/`, SITE.website).toString();
---

<Layout
  title={`${post.data.title} | ${SITE.title}`}
  description={post.data.description}
  ogImage={post.data.ogImage}
  pubDatetime={post.data.pubDatetime}
  modDatetime={post.data.modDatetime}
>
  <Header />
  <div class="progress-container fixed left-0 top-0 z-50 h-1 w-full bg-background/80">
    <div id="reading-progress" class="h-full w-0 bg-accent transition-[width]"></div>
  </div>
  <main id="main-content" class="app-layout py-10">
    <div class="mx-auto max-w-3xl">
      <a
        href="/posts/"
        class="inline-flex items-center gap-2 text-sm text-foreground/70 transition hover:text-accent"
      >
        <span aria-hidden="true">←</span>
        Back to posts
      </a>

      <article class="mt-6">
      <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        {post.data.title}
      </h1>
      <Datetime
        pubDatetime={post.data.pubDatetime}
        modDatetime={post.data.modDatetime}
        class="mt-3"
      />

      {post.data.tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-3">
          {post.data.tags.map(tag => (
            <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
          ))}
        </ul>
      )}

        <div class="app-prose mt-10 max-w-none">
          <Content />
        </div>

        <div class="mt-10 flex flex-col gap-4 border-t border-dashed border-border pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm font-medium text-foreground/70">Share this post</p>
          <ShareLinks title={post.data.title} url={canonicalUrl} />
        </div>
      </article>

      <div class="mt-12 grid gap-4 border-t border-dashed border-border pt-8 sm:grid-cols-2">
        <div>
          {previousPost && (
            <a
              href={`/posts/${getPostSlug(previousPost.id)}/`}
              class="group block rounded-2xl border border-border bg-background/70 p-5 transition hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-sm"
            >
              <div class="flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-foreground/55">
                <span aria-hidden="true" class="transition group-hover:-translate-x-0.5">←</span>
                Previous Post
              </div>
              <div class="mt-3 text-base font-semibold leading-7 text-foreground transition group-hover:text-accent">
                {previousPost.data.title}
              </div>
            </a>
          )}
        </div>
        <div>
          {nextPost && (
            <a
              href={`/posts/${getPostSlug(nextPost.id)}/`}
              class="group block rounded-2xl border border-border bg-background/70 p-5 text-left transition hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-sm sm:text-right"
            >
              <div class="flex items-center justify-start gap-2 text-xs uppercase tracking-[0.18em] text-foreground/55 sm:justify-end">
                Next Post
                <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
              </div>
              <div class="mt-3 text-base font-semibold leading-7 text-foreground transition group-hover:text-accent">
                {nextPost.data.title}
              </div>
            </a>
          )}
        </div>
      </div>
    </div>
  </main>
  <Footer />
  <BackToTopButton />
</Layout>

<script>
  function mountReadingEnhancements() {
    const progressBar = document.querySelector('#reading-progress');
    if (!(progressBar instanceof HTMLDivElement)) return;

    const updateScrollProgress = () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      progressBar.style.width = `${scrolled}%`;
    };

    const headings = Array.from(document.querySelectorAll('.app-prose h2, .app-prose h3, .app-prose h4, .app-prose h5, .app-prose h6'));
    for (const heading of headings) {
      if (!(heading instanceof HTMLElement) || !heading.id || heading.dataset.headingLinked === 'true') continue;
      heading.dataset.headingLinked = 'true';
      heading.classList.add('group');
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.className = 'heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100';
      link.textContent = '#';
      heading.appendChild(link);
    }

    const copyButtonLabel = 'Copy';
    document.querySelectorAll('.app-prose pre').forEach(block => {
      if (!(block instanceof HTMLElement) || block.dataset.copyMounted === 'true') return;
      block.dataset.copyMounted = 'true';
      block.classList.add('relative');
      const button = document.createElement('button');
      button.type = 'button';
      button.className =
        'copy-code absolute right-3 top-3 rounded border border-border bg-background px-2 py-1 text-xs font-medium';
      button.textContent = copyButtonLabel;
      button.onclick = async () => {
        const code = block.querySelector('code');
        await navigator.clipboard.writeText(code?.textContent ?? '');
        button.textContent = 'Copied';
        window.setTimeout(() => {
          button.textContent = copyButtonLabel;
        }, 800);
      };
      block.appendChild(button);
    });

    updateScrollProgress();
    window.onscroll = updateScrollProgress;
  }

  mountReadingEnhancements();
  document.addEventListener('astro:after-swap', () => {
    window.scrollTo({ left: 0, top: 0, behavior: 'instant' });
    mountReadingEnhancements();
  });
</script>
