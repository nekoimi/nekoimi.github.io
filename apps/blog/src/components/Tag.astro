---
type Props = {
  tag: string;
  tagName?: string;
  size?: 'sm' | 'lg';
};

const { tag, tagName = tag, size = 'lg' } = Astro.props;
---

<li>
  <a
    href={`/tags/${tag}/`}
    class:list={[
      'inline-flex items-center gap-1 rounded-full border border-border px-3 py-1 text-foreground/80 transition hover:border-accent/40 hover:text-accent',
      { 'text-xs': size === 'sm' },
      { 'text-sm': size === 'lg' },
    ]}
  >
    <span aria-hidden="true">#</span>
    {tagName}
  </a>
</li>
