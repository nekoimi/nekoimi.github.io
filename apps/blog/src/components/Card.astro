---
import type { CollectionEntry } from 'astro:content';
import Datetime from './Datetime.astro';
import Tag from './Tag.astro';
import getPostSlug from '../utils/getPostSlug';
import { slugifyStr } from '../utils/slugify';

type Props = {
  variant?: 'h2' | 'h3';
} & CollectionEntry<'blog'>;

const { variant: Heading = 'h2', id, data } = Astro.props;
---

<li class="my-6">
  <article class="app-card p-6">
    <a href={`/posts/${getPostSlug(id)}/`} class="block">
      <Heading class="text-xl font-semibold tracking-tight text-foreground transition hover:text-accent">
        {data.title}
      </Heading>
    </a>
    <Datetime
      pubDatetime={data.pubDatetime}
      modDatetime={data.modDatetime}
      class="mt-2"
    />
    <p class="mt-3 text-foreground/80">{data.description}</p>
    {data.tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {data.tags.map(tag => (
          <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
        ))}
      </ul>
    )}
  </article>
</li>
