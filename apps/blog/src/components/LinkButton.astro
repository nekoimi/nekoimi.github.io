---
type Props = {
  href: string;
  className?: string;
};

const { href, className = '' } = Astro.props;
---

<a
  href={href}
  class={`inline-flex items-center gap-2 rounded-md border border-border px-4 py-2 text-sm transition hover:border-accent/40 hover:text-accent ${className}`}
>
  <slot />
</a>
