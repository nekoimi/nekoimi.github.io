<button
  id="back-to-top"
  type="button"
  class="fixed bottom-5 right-5 hidden rounded-full border border-border bg-background px-3 py-2 text-sm shadow-sm transition hover:border-accent/40 hover:text-accent"
  aria-label="Back to top"
>
  Top
</button>

<script>
  function mountBackToTopButton() {
    const button = document.querySelector('#back-to-top');
    if (!(button instanceof HTMLButtonElement)) return;

    const updateVisibility = () => {
      button.classList.toggle('hidden', window.scrollY < 320);
    };

    button.onclick = () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    updateVisibility();
    window.addEventListener('scroll', updateVisibility, { passive: true });
  }

  mountBackToTopButton();
  document.addEventListener('astro:after-swap', mountBackToTopButton);
</script>
