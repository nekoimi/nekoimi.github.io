<button
  id="back-to-top"
  type="button"
  class="fixed bottom-5 right-5 hidden h-11 w-11 items-center justify-center rounded-full border border-border bg-background/95 text-foreground/75 shadow-sm backdrop-blur transition hover:-translate-y-0.5 hover:border-accent/40 hover:text-accent"
  aria-label="Back to top"
>
  <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
    <path d="m12 6 6 6-1.4 1.4-3.6-3.6V19h-2V9.8l-3.6 3.6L6 12l6-6Z"></path>
  </svg>
</button>

<script>
  function mountBackToTopButton() {
    const button = document.querySelector('#back-to-top');
    if (!(button instanceof HTMLButtonElement)) return;

    const updateVisibility = () => {
      button.classList.toggle('hidden', window.scrollY < 320);
    };

    button.onclick = () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    updateVisibility();
    window.addEventListener('scroll', updateVisibility, { passive: true });
  }

  mountBackToTopButton();
  document.addEventListener('astro:after-swap', mountBackToTopButton);
</script>
