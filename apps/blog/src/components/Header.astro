---
import { SITE } from '../config';

const { pathname } = Astro.url;

function isActive(path: string) {
  const currentPath = pathname.endsWith('/') && pathname !== '/' ? pathname.slice(0, -1) : pathname;
  if (path === '/') return currentPath === '/';
  const normalizedPath = path.endsWith('/') && path !== '/' ? path.slice(0, -1) : path;
  return currentPath === normalizedPath || currentPath.startsWith(`${normalizedPath}/`);
}
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2"
>
  Skip to content
</a>

<header class="app-layout">
  <div class="flex items-center justify-between border-b border-border py-5">
    <a href="/" class="text-2xl font-semibold tracking-tight">
      {SITE.title}
    </a>

    <div class="flex items-center gap-2 sm:hidden">
      {SITE.lightAndDarkMode && (
        <button
          id="theme-toggle"
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border transition hover:border-accent/40 hover:text-accent"
          aria-label="Toggle theme"
        >
          <span class="theme-icon-light" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current">
              <path d="M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12Zm0-16a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1Zm0 18a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1ZM4 11a1 1 0 1 1 0 2H3a1 1 0 1 1 0-2h1Zm18 0a1 1 0 1 1 0 2h-1a1 1 0 1 1 0-2h1ZM5.636 4.222a1 1 0 0 1 1.414 0l.707.707A1 1 0 0 1 6.343 6.343l-.707-.707a1 1 0 0 1 0-1.414Zm11.314 11.314a1 1 0 0 1 1.414 0l.707.707a1 1 0 0 1-1.414 1.414l-.707-.707a1 1 0 0 1 0-1.414ZM19.778 4.222a1 1 0 0 1 0 1.414l-.707.707a1 1 0 0 1-1.414-1.414l.707-.707a1 1 0 0 1 1.414 0ZM8.05 15.536a1 1 0 0 1 0 1.414l-.707.707a1 1 0 1 1-1.414-1.414l.707-.707a1 1 0 0 1 1.414 0Z"></path>
            </svg>
          </span>
          <span class="theme-icon-dark hidden" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current">
              <path d="M21 12.79A9 9 0 0 1 11.21 3a1 1 0 0 0-1.2 1.2 7 7 0 1 0 8.79 8.79 1 1 0 0 0 1.2-1.2Z"></path>
            </svg>
          </span>
        </button>
      )}
      <button
        id="menu-btn"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border transition hover:border-accent/40 hover:text-accent"
        aria-expanded="false"
        aria-controls="menu-items"
        aria-label="Open menu"
      >
        <span id="menu-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current">
            <path d="M4 7h16v2H4V7Zm0 8v-2h16v2H4Z"></path>
          </svg>
        </span>
        <span id="close-icon" class="hidden" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current">
            <path d="m6.4 5 5.6 5.6L17.6 5 19 6.4 13.4 12 19 17.6 17.6 19 12 13.4 6.4 19 5 17.6 10.6 12 5 6.4 6.4 5Z"></path>
          </svg>
        </span>
      </button>
    </div>

    <nav class="hidden items-center gap-5 text-sm sm:flex">
      <a href="/posts/" class:list={{ 'active-nav': isActive('/posts') }}>
        Posts
      </a>
      <a href="/tags/" class:list={{ 'active-nav': isActive('/tags') }}>
        Tags
      </a>
      <a href="/about/" class:list={{ 'active-nav': isActive('/about') }}>
        About
      </a>
      <a href="/search/" class:list={{ 'active-nav': isActive('/search') }}>
        Search
      </a>
      {SITE.lightAndDarkMode && (
        <button
          id="theme-toggle-desktop"
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border transition hover:border-accent/40 hover:text-accent"
          aria-label="Toggle theme"
        >
          <span class="theme-icon-light" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current">
              <path d="M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12Zm0-16a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1Zm0 18a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1ZM4 11a1 1 0 1 1 0 2H3a1 1 0 1 1 0-2h1Zm18 0a1 1 0 1 1 0 2h-1a1 1 0 1 1 0-2h1ZM5.636 4.222a1 1 0 0 1 1.414 0l.707.707A1 1 0 0 1 6.343 6.343l-.707-.707a1 1 0 0 1 0-1.414Zm11.314 11.314a1 1 0 0 1 1.414 0l.707.707a1 1 0 0 1-1.414 1.414l-.707-.707a1 1 0 0 1 0-1.414ZM19.778 4.222a1 1 0 0 1 0 1.414l-.707.707a1 1 0 0 1-1.414-1.414l.707-.707a1 1 0 0 1 1.414 0ZM8.05 15.536a1 1 0 0 1 0 1.414l-.707.707a1 1 0 1 1-1.414-1.414l.707-.707a1 1 0 0 1 1.414 0Z"></path>
            </svg>
          </span>
          <span class="theme-icon-dark hidden" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current">
              <path d="M21 12.79A9 9 0 0 1 11.21 3a1 1 0 0 0-1.2 1.2 7 7 0 1 0 8.79 8.79 1 1 0 0 0 1.2-1.2Z"></path>
            </svg>
          </span>
        </button>
      )}
    </nav>
  </div>

  <nav id="menu-items" class="hidden border-b border-border py-4 sm:hidden">
    <div class="flex flex-col gap-3 text-sm">
      <a href="/posts/" class:list={{ 'active-nav': isActive('/posts') }}>
        Posts
      </a>
      <a href="/tags/" class:list={{ 'active-nav': isActive('/tags') }}>
        Tags
      </a>
      <a href="/about/" class:list={{ 'active-nav': isActive('/about') }}>
        About
      </a>
      <a href="/search/" class:list={{ 'active-nav': isActive('/search') }}>
        Search
      </a>
    </div>
  </nav>
</header>

<script>
  function syncThemeIcons(theme) {
    document.querySelectorAll('.theme-icon-light').forEach(icon => {
      icon.classList.toggle('hidden', theme !== 'light');
    });
    document.querySelectorAll('.theme-icon-dark').forEach(icon => {
      icon.classList.toggle('hidden', theme !== 'dark');
    });
  }

  function mountThemeToggle() {
    document.querySelectorAll('#theme-toggle, #theme-toggle-desktop').forEach(toggle => {
      if (!(toggle instanceof HTMLButtonElement)) return;
      toggle.onclick = () => {
        const html = document.documentElement;
        const nextTheme = html.dataset.theme === 'dark' ? 'light' : 'dark';
        html.dataset.theme = nextTheme;
        localStorage.setItem('theme', nextTheme);
        syncThemeIcons(nextTheme);
      };
    });

    syncThemeIcons(document.documentElement.dataset.theme || 'light');
  }

  function toggleNav() {
    const menuBtn = document.querySelector('#menu-btn');
    const menuItems = document.querySelector('#menu-items');
    const menuIcon = document.querySelector('#menu-icon');
    const closeIcon = document.querySelector('#close-icon');
    if (
      !(menuBtn instanceof HTMLButtonElement) ||
      !(menuItems instanceof HTMLElement) ||
      !(menuIcon instanceof HTMLElement) ||
      !(closeIcon instanceof HTMLElement)
    ) {
      return;
    }

    menuBtn.onclick = () => {
      const openMenu = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', openMenu ? 'false' : 'true');
      menuBtn.setAttribute('aria-label', openMenu ? 'Open menu' : 'Close menu');
      menuItems.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    };
  }

  mountThemeToggle();
  toggleNav();
  document.addEventListener('astro:after-swap', () => {
    mountThemeToggle();
    toggleNav();
  });
</script>
