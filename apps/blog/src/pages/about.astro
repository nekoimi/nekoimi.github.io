---
import Layout from '../layouts/Layout.astro';
import Main from '../layouts/Main.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Socials from '../components/Socials.astro';
import { SITE } from '../config';
---

<Layout title={`About | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle="About"
    pageDesc="A minimal notebook for project updates, product thinking, and development notes."
  >
    <div class="app-prose max-w-none">
      <p>
        This blog is the writing corner of my personal site. I use it to keep
        track of product experiments, small tools, implementation notes, and
        occasional ideas worth saving.
      </p>
      <p>
        The current version is intentionally minimal and now follows AstroPaper
        more closely in navigation, post layout, reading flow, and overall
        presentation.
      </p>
    </div>
    <div class="mt-8">
      <p class="mb-3 text-sm text-foreground/65">Find me here:</p>
      <Socials />
    </div>
  </Main>
  <Footer />
</Layout>
