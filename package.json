{
  "name": "sakuraio-web",
  "private": true,
  "scripts": {
    "dev:synthworks": "pnpm --filter synthworks dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev:tools": "pnpm --filter tools dev",
    "dev:blog": "pnpm --filter blog dev",
    "dev": "pnpm dev:blog",
    "dev:web": "pnpm dev:synthworks",
    "build:synthworks": "pnpm --filter synthworks build",
    "build:docs": "pnpm --filter docs build",
    "build:tools": "pnpm --filter tools build",
    "build:blog": "pnpm --filter blog build",
    "build": "pnpm build:blog && pnpm build:docs && pnpm build:tools && pnpm build:synthworks",
    "build:web": "pnpm build:synthworks"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
